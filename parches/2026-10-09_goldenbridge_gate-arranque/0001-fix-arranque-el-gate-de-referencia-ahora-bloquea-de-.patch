From 9b588f6e7a0d18ee526d1880c85d6334d127cac9 Mon Sep 17 00:00:00 2001
From: emerson rios <h.rios.emerson@gmail.com>
Date: Fri, 9 Oct 2026 18:54:54 -0600
Subject: [PATCH] fix(arranque): el gate de referencia ahora bloquea de verdad
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

El gate evaluaba `pytest … | tail -20` dentro de `if !`. En sh sin
pipefail el status de una tubería es el del último mandato: `tail`
devolvía 0 y la rama "no se sirve tráfico" era inalcanzable. Con la
referencia fallida —CPU sin avx512_vnni, modelo u ORT distintos— el
contenedor imprimía "referencia OK" y servía.

Ahora el gate exige tres condiciones, leídas del informe JUnit:
- pytest sale con 0 (sin tubería);
- cero pruebas saltadas: los módulos de referencia se saltan enteros si
  falta su .npz (pytestmark skipif) y un salto pasaba como éxito;
- exactamente GB_GATE_CASOS_ESPERADOS casos (default 12).
Un informe ilegible cuenta como fallo.

Además:
- el chequeo de artefactos incluye vad_probs.npz y vad_stack.json;
- GB_SOLO_GATE=1 verifica y sale sin servir, para CI y prueba negativa.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 docker/arranque.sh | 73 +++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 69 insertions(+), 4 deletions(-)

diff --git a/docker/arranque.sh b/docker/arranque.sh
index 5f0e8b8..92105a2 100644
--- a/docker/arranque.sh
+++ b/docker/arranque.sh
@@ -14,17 +14,34 @@
 #
 # En producción de voz eso es el bot cortando (o no) a alguien a mitad de frase.
 # Sin este gate, el contenedor arrancaría igual y nadie se enteraría.
+#
+# Cómo decide el gate (2026-10-09). La versión anterior evaluaba
+# `pytest … | tail -20`: en sh sin pipefail el status de una tubería es el del
+# ÚLTIMO mandato, así que `tail` (siempre 0) tapaba cualquier fallo y la rama
+# "no se sirve tráfico" era inalcanzable. Ahora el gate exige las TRES cosas:
+#   1. pytest sale con 0;
+#   2. CERO pruebas saltadas — los dos módulos de referencia se saltan enteros
+#      si falta su .npz (pytestmark skipif), y un salto pasa como éxito;
+#   3. exactamente GB_GATE_CASOS_ESPERADOS casos — si alguien borra o renombra
+#      una prueba, el gate lo ve.
+# Cualquier duda (informe ilegible, conteo imposible) cuenta como fallo.
 set -eu
 
+GB_GATE_CASOS_ESPERADOS="${GB_GATE_CASOS_ESPERADOS:-12}"
+
 echo "[arranque] GoldenBridge — $(python -c 'import sys;print(sys.version.split()[0], "GIL:", sys._is_gil_enabled())')"
 echo "[arranque] hilos fijados: ORT_INTRA_OP=${GB_ORT_INTRA_OP:-?} OPENBLAS=${OPENBLAS_NUM_THREADS:-?} OMP=${OMP_NUM_THREADS:-?}"
 echo "[arranque] TORCH_HOME=${TORCH_HOME:-?}  ·  config=${GB_CONFIG}"
 
 # ── los artefactos tienen que estar ANTES de mirar nada más ─────────────────
+# Incluye los dos de Silero: sin vad_probs.npz el módulo del VAD se salta
+# completo y, antes de este cambio, el gate lo daba por bueno.
 falta=0
 for f in /app/smart-turn/smart-turn-v3.2-cpu.onnx \
          /app/test/reference/features.npz \
-         /app/test/reference/stack.json; do
+         /app/test/reference/stack.json \
+         /app/test/reference/vad_probs.npz \
+         /app/test/reference/vad_stack.json; do
     [ -f "$f" ] || { echo "[arranque] FALTA: $f" >&2; falta=1; }
 done
 [ -d "${TORCH_HOME}/hub/snakers4_silero-vad_master" ] || {
@@ -39,9 +56,48 @@ if [ "${GB_SALTAR_GATE:-0}" = "1" ]; then
     echo "[arranque] ⚠ GATE SALTEADO por GB_SALTAR_GATE=1 — sólo para depurar."
     echo "[arranque] ⚠ El comportamiento del modelo en este CPU NO está verificado."
 else
-    echo "[arranque] verificando la referencia congelada..."
-    if ! python -m pytest test/reference/ test/test_reference_features.py \
-                          test/test_reference_vad.py -q --no-header 2>&1 | tail -20; then
+    echo "[arranque] verificando la referencia congelada (se esperan ${GB_GATE_CASOS_ESPERADOS} casos, cero saltados)..."
+    salida="$(mktemp)"
+    informe="$(mktemp)"
+
+    # Sin tubería: el código de salida es el de pytest, no el de otro mandato.
+    estado=0
+    python -m pytest test/reference/ test/test_reference_features.py \
+                     test/test_reference_vad.py -q --no-header -rs \
+                     -p no:cacheprovider --junitxml="$informe" \
+                     >"$salida" 2>&1 || estado=$?
+    tail -20 "$salida"
+
+    # Conteo desde el informe JUnit, no desde el texto de pytest.
+    conteo="$(python - "$informe" <<'PY' 2>/dev/null || true
+import sys
+import xml.etree.ElementTree as ET
+raiz = ET.parse(sys.argv[1]).getroot()
+suites = [raiz] if raiz.tag == "testsuite" else raiz.findall("testsuite")
+total = {"tests": 0, "failures": 0, "errors": 0, "skipped": 0}
+for s in suites:
+    for k in total:
+        total[k] += int(s.get(k, 0))
+print(total["tests"], total["failures"], total["errors"], total["skipped"])
+PY
+)"
+    rm -f "$salida" "$informe"
+
+    casos=-1; fallos=-1; errores=-1; saltadas=-1
+    if [ -n "$conteo" ]; then
+        # shellcheck disable=SC2086
+        set -- $conteo
+        casos="$1"; fallos="$2"; errores="$3"; saltadas="$4"
+    fi
+    echo "[arranque] gate: pytest=${estado} casos=${casos}/${GB_GATE_CASOS_ESPERADOS} fallos=${fallos} errores=${errores} saltadas=${saltadas}"
+
+    motivo=""
+    [ "$estado" -eq 0 ] || motivo="${motivo} pytest salió con ${estado};"
+    [ "$saltadas" = "0" ] || motivo="${motivo} ${saltadas} pruebas saltadas (debe ser 0);"
+    [ "$casos" = "$GB_GATE_CASOS_ESPERADOS" ] || motivo="${motivo} ${casos} casos (se esperaban ${GB_GATE_CASOS_ESPERADOS});"
+
+    if [ -n "$motivo" ]; then
+        echo "[arranque] motivo:${motivo}" >&2
         cat >&2 <<'FIN'
 
 [arranque] ══════════════════════════════════════════════════════════════════
@@ -57,6 +113,8 @@ else
 [arranque]      sobra. Hoy sólo `avx512_vnni` tiene efecto medido.
 [arranque]   2. test_corpus_intacto — el hash del modelo o del audio cambió.
 [arranque]   3. los tests de decisión — si fallan y (1) pasó, el stack se movió.
+[arranque]   4. pruebas saltadas o conteo distinto — falta una referencia o se
+[arranque]      tocó la suite; eso también deja el modelo sin verificar.
 [arranque]
 [arranque] NO regenerar la referencia por reflejo: primero hay que decidir cuál
 [arranque] hardware es el de producción, porque ese define lo correcto.
@@ -67,6 +125,13 @@ FIN
     echo "[arranque] referencia OK — el modelo decide igual que en producción."
 fi
 
+# GB_SOLO_GATE=1: verificar y salir sin servir. Para CI y para la prueba
+# negativa del gate; en producción no se define.
+if [ "${GB_SOLO_GATE:-0}" = "1" ]; then
+    echo "[arranque] GB_SOLO_GATE=1 — gate verificado, no se sirve tráfico."
+    exit 0
+fi
+
 # ── a servir ────────────────────────────────────────────────────────────────
 echo "[arranque] iniciando en el puerto ${GB_PUERTO}"
 exec python -m src.main --config "${GB_CONFIG}" --port "${GB_PUERTO}"
-- 
2.51.2.windows.1

